# Copia questo file in ".env" (cp .env.example .env) e cambia i valori che ti servono.
# Il file ".env" è escluso da git. Tutte le variabili sono opzionali.

# --- docker-compose.yml (con reverse proxy, es. Nginx Proxy Manager) ---
# Nome della rete Docker condivisa con il proxy (docker network ls).
PROXY_NETWORK=nginx-proxy-manager
# Nome del container: nel proxy lo userai come "Forward Hostname".
CONTAINER_NAME=fatture_elettroniche_explorer

# --- docker-compose.standalone.yml (senza proxy) ---
# Porta del computer su cui esporre l'app.
HOST_PORT=8080
# 127.0.0.1 = solo questo computer; 0.0.0.0 = tutta la rete locale.
BIND_ADDRESS=127.0.0.1
